<ui:FluentWindow x:Class="OpenUkulele.Desktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:OpenUkulele.Desktop.Views"
                 Title="OpenUkulele"
                 Width="1180" Height="760"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenUkulele · 尤克里里指弹谱生成" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="8">
                <StackPanel>
                    <TextBlock Text="OpenUkulele" FontWeight="Bold" FontSize="16" Margin="8,12" />
                    <ui:Button Content="生成谱面" Icon="{ui:SymbolIcon MusicInfo24}" Appearance="Primary" Margin="0,2" />
                    <ui:Button Content="关于" Icon="{ui:SymbolIcon Info24}" Margin="0,2" IsEnabled="False" />
                    <TextBlock Text="v0.1 · 本地离线" FontSize="11" Opacity="0.6" Margin="8,24,8,0" />
                </StackPanel>
            </Border>

            <views:ArrangeView x:Name="ArrangePage" Grid.Column="1" Margin="12" />
        </Grid>
    </Grid>
</ui:FluentWindow>
